// VAREN Chapter 1 Normal save database ERD: gameSave_v2.db
// Paste this file into https://dbdiagram.io to view the diagram.
// Source: Assets/Scripts/Save/SaveDatabaseSchema.cs and Assets/Scripts/Save/SaveModels.cs
// Schema version 12; updated 2026-11-25.
// Every game-state table references SaveProfileData.Id through SaveProfileId.

Table SaveProfileData {
  Id integer [pk]
  SaveName varchar
  Difficulty varchar
  SchemaVersion integer
}

Table PlayerData {
  Id integer [pk, increment]
  SaveProfileId integer [not null]
  PosX float
  PosY float
  PosZ float
  RotX float
  RotY float
  RotZ float
  RotW float
  Health float
  MaxHealth float
  Sensitivity float
  CurrentScene varchar
}

Table InventoryData {
  Id integer [pk, increment]
  SaveProfileId integer [not null]
  ItemName varchar
  Quantity integer
  IsEquipped boolean
}

Table DoorData {
  Id integer [pk, increment]
  SaveProfileId integer [not null]
  DoorId varchar
  DoorName varchar
  IsUnlocked boolean
  IsOpen boolean
  RotX float
  RotY float
  RotZ float
  RotW float
}

Table DrawerData {
  Id integer [pk, increment]
  SaveProfileId integer [not null]
  DrawerId varchar
  DrawerName varchar
  IsOpen boolean
  LocalPosX float
  LocalPosY float
  LocalPosZ float
}

Table RitualData {
  Id integer [pk, increment]
  SaveProfileId integer [not null]
  IsComplete boolean
}

Table NoteData {
  Id integer [pk, increment]
  SaveProfileId integer [not null]
  NoteTitle varchar
  IsRead boolean
}

Table GameStateData {
  Id integer [pk, increment]
  SaveProfileId integer [not null]
  Key varchar
  Value varchar

  Note: 'General key/value state. Path-guide progress uses Key = PathGuide:<guide-id> and Value = waypoint index.'
}

Table DroppedItemData {
  Id integer [pk, increment]
  BananaFruitId varchar [note: 'Logical link to BananaFruitData.FruitId for world bananas; null for other items. Not a SQLite foreign key.']
  SaveProfileId integer [not null]
  ItemName varchar
  IsHeld boolean
  IsDropped boolean
  PosX float
  PosY float
  PosZ float
  RotX float
  RotY float
  RotZ float
  RotW float
}

Table FlashlightData {
  Id integer [pk, increment]
  SaveProfileId integer [not null]
  FlashlightName varchar
  BatteryLife float
  CurrentBattery float
  IsOn boolean
  IsHeld boolean
}

Table KeyData {
  Id integer [pk, increment]
  SaveProfileId integer [not null]
  KeyName varchar
  WasUsed boolean
}

Table BatteryData {
  Id integer [pk, increment]
  SaveProfileId integer [not null]
  BatteryName varchar
  RechargeAmount float
  IsHeld boolean
  IsUsed boolean
}

Table RitualItemData {
  Id integer [pk, increment]
  SaveProfileId integer [not null]
  ItemName varchar
  IsRevealed boolean
  IsPlaced boolean
}

Table ProgressionData {
  Id integer [pk, increment]
  SaveProfileId integer [not null]
  ProgressValue integer
  TotalPoints integer
}

Table SubtitleData {
  SubtitleId varchar [pk]
  SaveProfileId integer [not null]
  IsTriggered boolean
}

Table IntroData {
  Id integer [pk]
  SaveProfileId integer [not null]
  SectionIndex integer
  LineIndex integer
  IsComplete boolean
}

Table AIPositionData {
  Id integer [pk, increment]
  SaveProfileId integer [not null]
  AIId varchar
  SceneName varchar
  PosX float
  PosY float
  PosZ float
  RotX float
  RotY float
  RotZ float
  RotW float
}

// Real foreign-key relationships
Ref: SaveProfileData.Id < PlayerData.SaveProfileId [delete: cascade]
Ref: SaveProfileData.Id < InventoryData.SaveProfileId [delete: cascade]
Ref: SaveProfileData.Id < DoorData.SaveProfileId [delete: cascade]
Ref: SaveProfileData.Id < DrawerData.SaveProfileId [delete: cascade]
Ref: SaveProfileData.Id < RitualData.SaveProfileId [delete: cascade]
Ref: SaveProfileData.Id < NoteData.SaveProfileId [delete: cascade]
Ref: SaveProfileData.Id < GameStateData.SaveProfileId [delete: cascade]
Ref: SaveProfileData.Id < DroppedItemData.SaveProfileId [delete: cascade]
Ref: SaveProfileData.Id < FlashlightData.SaveProfileId [delete: cascade]
Ref: SaveProfileData.Id < KeyData.SaveProfileId [delete: cascade]
Ref: SaveProfileData.Id < BatteryData.SaveProfileId [delete: cascade]
Ref: SaveProfileData.Id < RitualItemData.SaveProfileId [delete: cascade]
Ref: SaveProfileData.Id < ProgressionData.SaveProfileId [delete: cascade]
Ref: SaveProfileData.Id < SubtitleData.SaveProfileId [delete: cascade]
Ref: SaveProfileData.Id < IntroData.SaveProfileId [delete: cascade]
Ref: SaveProfileData.Id < AIPositionData.SaveProfileId [delete: cascade]

// Schema 12: independent banana snapshots in each profile's chapter database.
Table BananaHarvestData {
  SceneName varchar [pk]
  SaveProfileId integer [not null]
  CooldownRemaining float [note: 'Shared tree cooldown in remaining game seconds; starts at 30 after the final fruit is removed.']
  SelectedInventoryIndex integer
}

Table BananaFruitData {
  HasBeenPickedUp boolean [not null, default: false, note: 'First pickup permanently cancels uncollected expiry.']
  UncollectedSecondsRemaining float [not null, default: 30]
  FruitId varchar [pk]
  SaveProfileId integer [not null]
  SceneName varchar
  InventoryIndex integer [note: '-1 = world fruit; nonnegative = inventory slot.']
  IsActive boolean
  HealingAmount float [note: 'HP restored per fruit; configured to 20 on the Banana Fruit prefab.']
  ScaleX float
  ScaleY float
  ScaleZ float
}

Ref: SaveProfileData.Id < BananaHarvestData.SaveProfileId [delete: cascade]
Ref: SaveProfileData.Id < BananaFruitData.SaveProfileId [delete: cascade]

// BananaFruitData contains no Pos/Rot columns; world transforms use DroppedItemData.

// Chapter 1 Normal uses its own database per player profile.
// Tree placements remain Unity scene objects. DropLight is recreated at load, not stored as a table.
