// VAREN Chapter 1 Normal save database ERD: gameSave_v2.db
// Paste this file into https://dbdiagram.io to view the diagram.
// Source: Assets/SaveSystem.cs
// Every game-state table references SaveProfileData.Id through SaveProfileId.

Table SaveProfileData {
  Id integer [pk]
  SaveName varchar
  Difficulty varchar
  SchemaVersion integer
}

Table PlayerData {
  Id integer [pk, increment]
  SaveProfileId integer [not null]
  PosX float
  PosY float
  PosZ float
  RotX float
  RotY float
  RotZ float
  RotW float
  Health float
  MaxHealth float
  Sensitivity float
  CurrentScene varchar
}

Table InventoryData {
  Id integer [pk, increment]
  SaveProfileId integer [not null]
  ItemName varchar
  Quantity integer
  IsEquipped boolean
}

Table DoorData {
  Id integer [pk, increment]
  SaveProfileId integer [not null]
  DoorId varchar
  DoorName varchar
  IsUnlocked boolean
  IsOpen boolean
  RotX float
  RotY float
  RotZ float
  RotW float
}

Table DrawerData {
  Id integer [pk, increment]
  SaveProfileId integer [not null]
  DrawerId varchar
  DrawerName varchar
  IsOpen boolean
  LocalPosX float
  LocalPosY float
  LocalPosZ float
}

Table RitualData {
  Id integer [pk, increment]
  SaveProfileId integer [not null]
  IsComplete boolean
}

Table NoteData {
  Id integer [pk, increment]
  SaveProfileId integer [not null]
  NoteTitle varchar
  IsRead boolean
}

Table GameStateData {
  Id integer [pk, increment]
  SaveProfileId integer [not null]
  Key varchar
  Value varchar
}

Table DroppedItemData {
  Id integer [pk, increment]
  SaveProfileId integer [not null]
  ItemName varchar
  IsHeld boolean
  IsDropped boolean
  PosX float
  PosY float
  PosZ float
  RotX float
  RotY float
  RotZ float
  RotW float
}

Table FlashlightData {
  Id integer [pk, increment]
  SaveProfileId integer [not null]
  FlashlightName varchar
  BatteryLife float
  CurrentBattery float
  IsOn boolean
  IsHeld boolean
  WasDropped boolean
  PosX float
  PosY float
  PosZ float
}

Table KeyData {
  Id integer [pk, increment]
  SaveProfileId integer [not null]
  KeyName varchar
  WasUsed boolean
}

Table BatteryData {
  Id integer [pk, increment]
  SaveProfileId integer [not null]
  BatteryName varchar
  RechargeAmount float
  IsHeld boolean
  IsDropped boolean
  IsUsed boolean
  PosX float
  PosY float
  PosZ float
  RotX float
  RotY float
  RotZ float
  RotW float
}

Table RitualItemData {
  Id integer [pk, increment]
  SaveProfileId integer [not null]
  ItemName varchar
  IsRevealed boolean
  IsPlaced boolean
  IsDropped boolean
  PosX float
  PosY float
  PosZ float
  RotX float
  RotY float
  RotZ float
  RotW float
}

Table ProgressionData {
  Id integer [pk, increment]
  SaveProfileId integer [not null]
  ProgressValue integer
  TotalPoints integer
}

Table SubtitleData {
  SubtitleId varchar [pk]
  SaveProfileId integer [not null]
  IsTriggered boolean
}

Table StaminaData {
  Id integer [pk, increment]
  SaveProfileId integer [not null]
  CurrentStamina float
}

Table IntroData {
  Id integer [pk]
  SaveProfileId integer [not null]
  SectionIndex integer
  LineIndex integer
  IsComplete boolean
}

Table AIPositionData {
  Id integer [pk, increment]
  SaveProfileId integer [not null]
  AIId varchar
  SceneName varchar
  PosX float
  PosY float
  PosZ float
  RotX float
  RotY float
  RotZ float
  RotW float
}

// Real foreign-key relationships
Ref: SaveProfileData.Id < PlayerData.SaveProfileId
Ref: SaveProfileData.Id < InventoryData.SaveProfileId
Ref: SaveProfileData.Id < DoorData.SaveProfileId
Ref: SaveProfileData.Id < DrawerData.SaveProfileId
Ref: SaveProfileData.Id < RitualData.SaveProfileId
Ref: SaveProfileData.Id < NoteData.SaveProfileId
Ref: SaveProfileData.Id < GameStateData.SaveProfileId
Ref: SaveProfileData.Id < DroppedItemData.SaveProfileId
Ref: SaveProfileData.Id < FlashlightData.SaveProfileId
Ref: SaveProfileData.Id < KeyData.SaveProfileId
Ref: SaveProfileData.Id < BatteryData.SaveProfileId
Ref: SaveProfileData.Id < RitualItemData.SaveProfileId
Ref: SaveProfileData.Id < ProgressionData.SaveProfileId
Ref: SaveProfileData.Id < SubtitleData.SaveProfileId
Ref: SaveProfileData.Id < StaminaData.SaveProfileId
Ref: SaveProfileData.Id < IntroData.SaveProfileId
Ref: SaveProfileData.Id < AIPositionData.SaveProfileId
