  m_Name: 
  m_EditorClassIdentifier: 
  linkedSubtitleTrigger: {fileID: 0}
  onCloseObjective: {fileID: 0}
  onCloseAudio: {fileID: 0}
  noteTitle: Jude's Guard Log
  noteContent: 'Mil and I have been watching Father Mateo.

    He moves differently
    now. He speaks to empty rooms and walks toward the church after midnight.

    We
    do not know what is wrong with him, but something is not right.

    Laica and
    Shyna may know more. They are the closest to Father Mateo.

    I left a key
    on my table it is the key to laica and shyna''s home. '
  readRange: 2
  readKey: 101
