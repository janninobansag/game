  m_Script: {fileID: 11500000, guid: ff7a654d932174f45b141d2b0de5b863, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  linkedSubtitleTrigger: {fileID: 0}
  onCloseObjective: {fileID: 0}
  onCloseAudio: {fileID: 0}
  noteTitle: Old Note
  noteContent: 'I heard Father Mateo speaking inside the church last night.

    His
    voice did not sound like his own.

    Today, he told us all to gather for prayer.
    Laica and Shyna are already helping him prepare the candles, Bible, and cross.

    Mil
    is the only one who may understand what is happening. He and Jude have been watching
    Father Mateo too.

    I found the key to Mil''s house and hid it here.

    Take
    the key. Go to Mil''s home and find Mil.'
  readRange: 2
  readKey: 101
