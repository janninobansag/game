  m_Script: {fileID: 11500000, guid: ff7a654d932174f45b141d2b0de5b863, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  linkedSubtitleTrigger: {fileID: 0}
  onCloseObjective: {fileID: 1829975272}
  onCloseAudio: {fileID: 980127727}
  noteTitle: Shyna's Note
  noteContent: 'Laica is still preparing the candles Father Mateo asked for. I do
    not understand why he needs them for a simple prayer. He also asked us to prepare
    the Bible and the cross.

    Something feels wrong, but Laica says we should
    trust him. Ann from the next house wanted to speak with us. She said she saw
    Father Mateo near the church late at night.

    The key to Ann''s home is somewhere
    in this house.

    Find it, then go to Ann''s home.'
  readRange: 2
  readKey: 101
