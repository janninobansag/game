  m_Name: 
  m_EditorClassIdentifier: 
  linkedSubtitleTrigger: {fileID: 414109452}
  onCloseObjective: {fileID: 0}
  onCloseAudio: {fileID: 0}
  noteTitle: Ann's Journal
  noteContent: "Laica came here earlier and left one candle with me.\r\n\rShe said
    Father Mateo needed it for the prayer inside the church. The other candle is
    already somewhere in the church, but I do not know where she placed it.\r\n\rI
    hid Laica's candle inside this house.\r\n\rThere is also something important
    in the CR, but it is locked.\r\n\rThe key to the CR was left in the Guard House.\r\nGo
    back to the Guard House, find the key, then return here."
  readRange: 2
  readKey: 101
