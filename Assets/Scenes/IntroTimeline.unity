  m_GameObject: {fileID: 724227458}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ff7a654d932174f45b141d2b0de5b863, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  linkedSubtitleTrigger: {fileID: 0}
  onCloseObjective: {fileID: 0}
  onCloseAudio: {fileID: 0}
  noteTitle: Old Note
  noteContent: "Father Mateo gathered us and explained everything.\r\nThe thing beneath
    the church is not a demon.\r\nIt is older.\r\nIt listens. It learns.\r\nThe ritual
    must be restored using the sacred items\u2026\r\nor it will walk freely among
    us.\r\n\r\nHe said the last sacred item  the Cross  \r\nis kept in the third
    house.\r\nElena was guarding it.\r\nBut I haven't seen her in days.\r\n\r\nThe
    third house key is on the kitchen table.\r\nPlease... bring the Cross to the
    church."
  readRange: 2
  readKey: 101
