MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2052273201}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ff7a654d932174f45b141d2b0de5b863, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  linkedSubtitleTrigger: {fileID: 0}
  onCloseObjective: {fileID: 1829975272}
  onCloseAudio: {fileID: 980127727}
  noteTitle: Old Note
  noteContent: "I saw Maria walk into the church last night.\r\nShe was speaking
    to someone\u2026 but no one was there.\r\nThis morning, she was gone.\r\nNo footprints.
    No sound.\r\nJust silence.\r\n\r\nBefore she disappeared, she kept talking about
    \r\nsomething she found in the second house.\r\nA candle that never goes out.\r\nShe
    said it was \"warm like a heartbeat.\"\r\n\r\nI'm going to check the second house
    tomorrow.\r\nIf you're reading this...\r\nMaybe you should too."
  readRange: 2
  readKey: 101
